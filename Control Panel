<div id="control-panel-page" class="page">
  <div class="container-sm" style="padding-top:32px;padding-bottom:60px">
    <div class="page-header"><h1>Control Panel</h1><p>System management tools for administrators</p></div>
    <div class="settings-card">
      <h3>Danger Zone</h3>
      <div class="desc">Destructive actions — use with extreme caution</div>
      <div style="padding:20px;background:rgba(239,68,68,0.06);border:1px solid rgba(239,68,68,0.2);border-radius:var(--radius-sm)">
        <h4 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:0.95rem;margin-bottom:8px;color:var(--danger)">Clear All Application Data</h4>
        <p style="font-size:0.85rem;color:var(--text-soft);margin-bottom:16px">This will permanently delete all member applications. Admin and demo accounts will be preserved. This action cannot be undone.</p>
        <button class="btn btn-sm" style="background:rgba(239,68,68,0.1);color:var(--danger);border:1px solid rgba(239,68,68,0.2)" onclick="openClearAllDataModal()"><span class="material-symbols-rounded" style="font-size:16px">delete_forever</span> Clear All Data</button>
      </div>
    </div>
  </div>
</div>

<div class="modal-overlay" id="file-manager-modal">
  <div class="modal-content" style="max-width:720px">
    <div class="modal-header">
      <h2><span class="material-symbols-rounded" style="font-size:22px">folder_open</span> Select Document</h2>
      <button class="modal-close-btn" onclick="closeFileModal()"><span class="material-symbols-rounded">close</span></button>
    </div>
    <div class="modal-body">
      <div class="info-box info mb-20"><span class="material-symbols-rounded" style="font-size:18px;flex-shrink:0;color:var(--accent)">info</span>Select the correct document for each requirement. Your files must be valid and match the expected format.</div>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:20px;text-align:center">
        <div class="file-item" onclick="selectFile('Valid Government ID')">
          <div style="display:flex;justify-content:center;margin-bottom:12px"><div style="width:60px;height:60px;background:var(--gradient-main);border-radius:12px;display:flex;align-items:center;justify-content:center"><span class="material-symbols-rounded" style="font-size:34px;color:white">badge</span></div></div>
          <p style="font-size:0.87rem;color:var(--text);font-weight:600">Valid Government ID.docx</p>
          <p style="font-size:0.75rem;color:var(--text-muted);margin-top:4px">Required: Government ID</p>
        </div>
        <div class="file-item" onclick="selectFile('Proof of Address')">
          <div style="display:flex;justify-content:center;margin-bottom:12px"><div style="width:60px;height:60px;background:var(--gradient-gold);border-radius:12px;display:flex;align-items:center;justify-content:center"><span class="material-symbols-rounded" style="font-size:34px;color:white">home</span></div></div>
          <p style="font-size:0.87rem;color:var(--text);font-weight:600">Proof of Address.pdf</p>
          <p style="font-size:0.75rem;color:var(--text-muted);margin-top:4px">Required: Proof of Address</p>
        </div>
        <div class="file-item" onclick="selectFile('Recent 2x2 Photo')">
          <div style="display:flex;justify-content:center;margin-bottom:12px"><div style="width:60px;height:60px;background:var(--gradient-green);border-radius:12px;display:flex;align-items:center;justify-content:center"><span class="material-symbols-rounded" style="font-size:34px;color:white">portrait</span></div></div>
          <p style="font-size:0.87rem;color:var(--text);font-weight:600">2x2.png</p>
          <p style="font-size:0.75rem;color:var(--text-muted);margin-top:4px">Required: 2x2 Photo</p>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="modal-overlay" id="clear-all-data-modal">
  <div class="modal-content" style="max-width:480px">
    <div class="modal-header">
      <h2><span class="material-symbols-rounded" style="font-size:22px;color:var(--danger)">warning</span> Confirm Data Deletion</h2>
      <button class="modal-close-btn" onclick="closeClearAllDataModal()"><span class="material-symbols-rounded">close</span></button>
    </div>
    <div class="modal-body">
      <div class="info-box warning mb-16"><span class="material-symbols-rounded" style="font-size:18px;flex-shrink:0;color:var(--gold)">warning</span>This will permanently delete all enrollment applications. This cannot be undone.</div>
      <div style="margin-bottom:20px">
        <label style="font-size:0.9rem;color:var(--text);margin-bottom:8px;display:block">Type <strong style="color:var(--danger)">CONFIRM</strong> to proceed:</label>
        <input type="text" id="clear-confirm-input" class="input-field" placeholder="Type CONFIRM...">
        <p id="confirm-error" style="color:var(--danger);font-size:0.83rem;margin-top:8px;display:none">Please type CONFIRM exactly to proceed.</p>
      </div>
      <div style="display:flex;gap:12px">
        <button class="btn btn-ghost" style="flex:1;justify-content:center" onclick="closeClearAllDataModal()">Cancel</button>
        <button class="btn" style="flex:1;background:var(--danger);color:white;font-weight:600;justify-content:center" onclick="executeClearAllData()">Delete All</button>
      </div>
    </div>
  </div>
</div>

<div class="modal-overlay" id="philsys-modal">
  <div class="modal-content" style="max-width:480px">
    <div class="modal-header">
      <h2><span class="material-symbols-rounded" style="font-size:22px">verified_user</span> PhilSys ID Verification</h2>
      <button class="modal-close-btn" onclick="closePhilSysModal()"><span class="material-symbols-rounded">close</span></button>
    </div>
    <div class="modal-body">
      <div id="philsys-loading" style="text-align:center;padding:20px">
        <span class="material-symbols-rounded" style="font-size:48px;color:var(--accent);animation:spin 1.5s linear infinite;display:block;margin-bottom:16px">autorenew</span>
        <p style="color:var(--text-soft)">Verifying your PhilSys National ID...</p>
      </div>
      <div id="philsys-success" style="display:none">
        <div class="info-box success mb-16"><span class="material-symbols-rounded" style="font-size:18px;flex-shrink:0;color:var(--success)">check_circle</span>Identity verified successfully via PhilSys.</div>
        <div class="modal-grid">
          <div class="modal-field full"><label>Full Name</label><div class="modal-field-value" style="font-weight:700">Juan Dela Cruz</div></div>
          <div class="modal-field"><label>PhilSys ID</label><div class="modal-field-value">PHL-2847-5934-1204</div></div>
          <div class="modal-field"><label>Date of Birth</label><div class="modal-field-value">May 15, 1990</div></div>
        </div>
      </div>
    </div>
    <div class="modal-actions">
      <button class="btn btn-ghost" onclick="closePhilSysModal()">Cancel</button>
      <button class="btn btn-primary" onclick="completePhilSysLogin()" id="philsys-confirm-btn" style="display:none">Sign In</button>
    </div>
  </div>
</div>
 
<!-- Toast container -->
<div class="toast-container" id="toast-container"></div>
